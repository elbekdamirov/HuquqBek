# Copy to .env (same folder) and fill in. Restart the server after editing.
# Google sign-in: OAuth 2.0 "Web application" client ID from https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins must include the address you open, e.g. http://localhost:5173 and http://127.0.0.1:4197
GOOGLE_CLIENT_ID=
